# College Regulations RAG Chatbot - Environment Configuration
# Copy this file to .env and configure your keys if using an external LLM.
# If no key is provided, the application will use the built-in offline extractive synthesizer.

# LLM API Provider Configuration (Supports OpenAI, Groq, Ollama, OpenRouter, etc.)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Example for Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL_NAME=llama-3.3-70b-versatile

# Vector Store and Model Settings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.35
TOP_K_RESULTS=4
CHUNK_SIZE=600
CHUNK_OVERLAP=120
